#%PAM-1.0
# greetd's PAM service as TDE's login screen wants it: copy it to /etc/pam.d/greetd. Logging
# in with a password unlocks the keyring with it, and with the keyring the SSH keys whose
# passphrases it keeps, as with GDM; a new password is given to the keyring too.

auth       required     pam_securetty.so
auth       requisite    pam_nologin.so
auth       include      system-local-login
-auth      optional     pam_gnome_keyring.so
-auth      optional     pam_oo7.so
account    include      system-local-login
password   include      system-local-login
-password  optional     pam_gnome_keyring.so use_authtok
-password  optional     pam_oo7.so use_authtok
session    include      system-local-login
-session   optional     pam_gnome_keyring.so auto_start
-session   optional     pam_oo7.so auto_start
