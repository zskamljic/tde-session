[Unit]
Description=TDE bar (Hermes)
Documentation=https://github.com/zskamljic/tde-session
# Up and down with the session, which starts it.
PartOf=tde-session.target
After=tde-session.target

[Service]
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/tde-hermes
# Back at once should it crash; a lock screen it started stays meanwhile.
Restart=on-failure
RestartSec=1
KillMode=process
